# ==============================================================================
# Configurações do CRM Pro Gamificado
# ==============================================================================

# Segurança da Aplicação
SECRET_KEY=sua_chave_secreta_super_segura_aqui

# Banco de Dados PostgreSQL (Padrão de Produção)
DATABASE_URL=postgresql://waha_user:waha_password@localhost:5432/crm_db
# Ou alternativamente por partes:
# POSTGRES_USER=waha_user
# POSTGRES_PASSWORD=waha_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=crm_db

# Defina como 'true' apenas se desejar rodar em SQLite localmente para testes:
# USE_SQLITE=false

# Cache e Fila de Tarefas (Redis)
REDIS_URL=redis://localhost:6379/0

# WAHA (WhatsApp HTTP API)
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=admin123
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin123

# Ollama (Inteligência Artificial Local)
OLLAMA_URL=http://localhost:11434
